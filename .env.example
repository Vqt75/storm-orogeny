# Copier en .env pour le développement local. Ne jamais committer .env.
NODE_ENV=development
PORT=4000

# Base de données — voir docs/contracts/schema-and-migrations.md.
# En production, DB_PASSWORD n'a aucune valeur par défaut : le
# démarrage échoue explicitement si elle n'est pas fournie.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storm_orogeny_dev
DB_USER=storm_orogeny
DB_PASSWORD=storm_orogeny_dev
DB_SSL=0
